<Window x:Class="RevitVersionControl.UI.InitProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Initialize Project - CollabHub" Height="220" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Initialize Version Control" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="1">
            <TextBlock Text="Project Name:"/>
            <TextBox x:Name="ProjectNameInput" Height="25" Margin="0,5,0,0"/>
            <TextBlock Text="Current file will be uploaded as the initial version." FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Initialize" Width="80" Height="30" Click="InitButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
