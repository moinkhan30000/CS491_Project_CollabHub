<Page x:Class="RevitVersionControl.UI.HistoryPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Version History">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Version History" FontSize="16" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,15,0"/>
                    <TextBlock Name="CurrentTrackedBranchText" Text="Active Branch: -" 
                               FontSize="13" Foreground="#87CEFA" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Name="RefreshButton" Content="Refresh" Width="80" Height="25" Margin="0,0,10,5"
                            Click="RefreshButton_Click"/>
                    <TextBlock Text="Project:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <ComboBox Name="ProjectComboBox" Width="200" Height="25" Margin="0,0,0,5"
                              SelectionChanged="ProjectComboBox_SelectionChanged"
                              DisplayMemberPath="Name"/>
                    <TextBlock Text="Branch:" Foreground="White" VerticalAlignment="Center" Margin="15,0,5,5"/>
                    <ComboBox Name="BranchComboBox" Width="150" Height="25" Margin="0,0,0,5"
                              SelectionChanged="BranchComboBox_SelectionChanged"
                              DisplayMemberPath="Name"/>
                    <Button Name="ManageBranchesButton" Content="Manage Branches" Width="110" Height="25" Margin="10,0,0,5"
                            Click="ManageBranchesButton_Click"/>
                    <Button Name="NetworkGraphButton" Content="View Network Graph" Width="130" Height="25" Margin="10,0,0,5"
                            Click="NetworkGraphButton_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Commit List -->
        <ListView Grid.Row="1" x:Name="CommitListView" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Commit" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★ ACTIVE" Foreground="#4CAF50" FontWeight="Bold" Margin="0,0,5,0"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Message}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CommitId}" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Branch" Width="100" DisplayMemberBinding="{Binding BranchName}"/>
                    <GridViewColumn Header="Author" Width="120" DisplayMemberBinding="{Binding Author}"/>
                    <GridViewColumn Header="Date" Width="150" DisplayMemberBinding="{Binding Timestamp}"/>
                    <GridViewColumn Header="Changes" Width="80" DisplayMemberBinding="{Binding ChangedElements}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
