<Page x:Class="RevitVersionControl.UI.HistoryPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Version History">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <StackPanel>
                <TextBlock Text="Version History" FontSize="16" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Width="80" Height="25" Margin="0,0,5,0"/>
                    <ComboBox Width="150" Height="25" SelectedIndex="0">
                        <ComboBoxItem Content="All Branches"/>
                        <ComboBoxItem Content="Main Branch"/>
                        <ComboBoxItem Content="My Commits"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Commit List -->
        <ListView Grid.Row="1" x:Name="CommitListView" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Commit" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Message}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CommitId}" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Author" Width="120" DisplayMemberBinding="{Binding Author}"/>
                    <GridViewColumn Header="Date" Width="150" DisplayMemberBinding="{Binding Timestamp}"/>
                    <GridViewColumn Header="Changes" Width="80" DisplayMemberBinding="{Binding ChangedElements}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>