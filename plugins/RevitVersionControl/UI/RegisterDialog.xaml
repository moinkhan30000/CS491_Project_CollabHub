<Window x:Class="RevitVersionControl.UI.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register - CollabHub" Height="550" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Create Account" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="Full Name:"/>
            <TextBox x:Name="NameTextBox" Padding="5"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Label Content="Email:"/>
            <TextBox x:Name="EmailTextBox" Padding="5"/>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Label Content="Password:"/>
            <PasswordBox x:Name="PasswordBox" Padding="5"/>
        </StackPanel>
        
        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <Label Content="Confirm Password:"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Padding="5"/>
        </StackPanel>
        
        <Button x:Name="RegisterButton" Grid.Row="5" Content="Register" Height="30" Click="RegisterButton_Click" IsDefault="True"/>
        
        <Button Grid.Row="6" Content="Back to Login" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                Foreground="Gray" Click="CancelButton_Click" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0"/>
    </Grid>
</Window>
