<Page x:Class="RevitVersionControl.UI.DiffMergePane"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Changes &amp; Merge">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/> <!-- New row for conflicts -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <StackPanel>
                <TextBlock Text="Changes &amp; Merge" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Local: " Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BaseCommitText" Text="-" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Remote: " Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TargetCommitText" Text="-" Foreground="LightGray" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CONFLICTS LIST (Collapsable, only visible if conflicts exist) -->
        <Border Grid.Row="1" x:Name="ConflictsPanel" Background="#FFF3CD" Padding="10" Visibility="Collapsed" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <StackPanel>
                <TextBlock Text="Merge Conflicts Detected" FontSize="14" FontWeight="Bold" Foreground="#856404" Margin="0,0,0,5" />
                <ListView Name="ConflictsListView" BorderThickness="0" Background="Transparent" MaxHeight="250" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="3" Margin="0,0,0,5" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="#533F03" Margin="0,0,0,5" />
                                    <!-- Use a binding group to ensure only ONE radio is checked per conflict ID -->
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Keep Local" GroupName="{Binding ElementId}" IsChecked="{Binding KeepLocal, Mode=TwoWay}" Margin="0,0,15,0" />
                                        <RadioButton Content="Accept Remote" GroupName="{Binding ElementId}" IsChecked="{Binding AcceptRemote, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Changes List (Safe Auto-Merges) -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Summary -->
            <Border Grid.Row="0" Background="#F0F0F0" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#CCC">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Added: " FontWeight="Bold"/>
                    <TextBlock x:Name="AddedCountText" Text="0" Foreground="Green" Margin="0,0,15,0"/>
                    <TextBlock Text="Modified: " FontWeight="Bold"/>
                    <TextBlock x:Name="ModifiedCountText" Text="0" Foreground="Orange" Margin="0,0,15,0"/>
                    <TextBlock Text="Deleted: " FontWeight="Bold"/>
                    <TextBlock x:Name="DeletedCountText" Text="0" Foreground="Red"/>
                </StackPanel>
            </Border>

            <!-- Change Items -->
            <ListView Grid.Row="1" Name="ChangesListView" SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Width="40" Height="20" CornerRadius="3"
                                        Background="{Binding StatusColor}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChangeType}" Foreground="White"
                                               FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ElementType}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Details}" FontSize="10" Foreground="DarkGray"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#CCC">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Select All" Width="100" Height="30" Margin="0,0,5,0" Click="SelectAll_Click"/>
                <Button Content="Deselect All" Width="100" Height="30" Margin="0,0,15,0" Click="DeselectAll_Click"/>
                <Button x:Name="ApplyButton" Content="Apply Selected" Width="120" Height="30"
                        Background="#28A745" Foreground="White" FontWeight="Bold"
						Click="ApplySelected_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
