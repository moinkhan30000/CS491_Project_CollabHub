<Page x:Class="RevitVersionControl.UI.DiffViewerPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Diff Viewer">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <StackPanel>
                <TextBlock Text="Commit Diff Viewer" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Base: " Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BaseCommitText" Text="-" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text=" · " Foreground="LightGray" VerticalAlignment="Center"/>
                    <TextBlock Text="Target: " Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <TextBlock x:Name="TargetCommitText" Text="-" Foreground="LightGray" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusBanner" Text="" Foreground="#FFD700" FontStyle="Italic"
                           Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Summary + filters -->
        <Border Grid.Row="1" Background="#F0F0F0" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#CCC">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Δ " FontWeight="Bold"/>
                    <TextBlock x:Name="AddedCountText" Text="0 added" Foreground="#00C853" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="·" Foreground="Gray" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ModifiedCountText" Text="0 modified" Foreground="#B58900" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="·" Foreground="Gray" Margin="0,0,10,0"/>
                    <TextBlock x:Name="DeletedCountText" Text="0 deleted" Foreground="#D50000" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Show: " VerticalAlignment="Center"/>
                    <CheckBox x:Name="FilterAdded" Content="Added" IsChecked="True" Margin="5,0" Click="Filter_Click"/>
                    <CheckBox x:Name="FilterModified" Content="Modified" IsChecked="True" Margin="5,0" Click="Filter_Click"/>
                    <CheckBox x:Name="FilterDeleted" Content="Deleted" IsChecked="True" Margin="5,0" Click="Filter_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Rows -->
        <ListView Grid.Row="2" x:Name="RowsListView" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBrush}" CornerRadius="3" Padding="5,2">
                                    <TextBlock Text="{Binding ShortType}" Foreground="White" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Category" Width="120" DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="Type" Width="160" DisplayMemberBinding="{Binding TypeName}"/>
                    <GridViewColumn Header="Repo" Width="80" DisplayMemberBinding="{Binding ShortRepoGuid}"/>
                    <GridViewColumn Header="Note" Width="220" DisplayMemberBinding="{Binding Note}"/>
                    <GridViewColumn Header="" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Zoom To" Padding="3,1" Click="ZoomTo_Click"
                                        Tag="{Binding}" IsEnabled="{Binding HasGeometry}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#CCC">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CleanOrphansButton" Content="Clean Orphans" Width="120" Height="28"
                        Margin="0,0,8,0" Click="CleanOrphans_Click"
                        ToolTip="Remove every diff view and ghost from the document."/>
                <Button x:Name="ClearDiffButton" Content="Clear Diff View" Width="130" Height="28"
                        Background="#D50000" Foreground="White" FontWeight="Bold"
                        Click="ClearDiff_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
