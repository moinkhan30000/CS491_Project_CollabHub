<Window x:Class="RevitVersionControl.UI.NetworkGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Graph" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#2D2D30" Padding="10">
            <TextBlock Name="HeaderText" Text="Loading..." Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
            <Canvas x:Name="GraphCanvas" Background="#1E1E1E"/>
        </ScrollViewer>
    </Grid>
</Window>
