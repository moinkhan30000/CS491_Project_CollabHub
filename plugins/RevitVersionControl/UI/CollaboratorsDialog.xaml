<Window x:Class="RevitVersionControl.UI.CollaboratorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invite Collaborators - CollabHub" Height="250" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Invite to Project" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="1">
            <TextBlock Text="Select Project:" Margin="0,0,0,5"/>
            <ComboBox x:Name="ProjectComboBox" Height="25" Margin="0,0,0,10" DisplayMemberPath="Name" SelectedValuePath="ProjectId"/>
            
            <TextBlock Text="Email Address:" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailInput" Height="25"/>
            <TextBlock Text="User must already be registered with CollabHub." FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Send Invite" Width="100" Height="30" Click="InviteButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
