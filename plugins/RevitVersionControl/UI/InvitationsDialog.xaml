<Window x:Class="RevitVersionControl.UI.InvitationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Invitations - CollabHub" Height="400" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Pending Invitations" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <ListBox x:Name="InvitesList" Grid.Row="1" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProjectName}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Role, StringFormat='Role: {0}'}"/>
                            <TextBlock Text="{Binding InvitedAt, StringFormat='Sent: {0:g}'}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Content="Decline" Width="70" Height="25" Margin="5,0" 
                                Click="Decline_Click" Tag="{Binding InviteId}"/>
                        <Button Grid.Column="2" Content="Accept" Width="70" Height="25" 
                                Click="Accept_Click" Tag="{Binding InviteId}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="Close" Width="80" Height="30" HorizontalAlignment="Right" IsCancel="True"/>
    </Grid>
</Window>
