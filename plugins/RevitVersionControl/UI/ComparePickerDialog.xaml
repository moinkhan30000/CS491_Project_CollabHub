<Window x:Class="RevitVersionControl.UI.ComparePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare Commits" Height="380" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pick a commit on the same branch to compare against."
                   Margin="0,0,0,8" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Selected: " VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock x:Name="SelectedCommitText" Text="-" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <ListView Grid.Row="2" x:Name="CommitsListView" SelectionChanged="CommitsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Commit" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Message}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ShortCommitId}" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Author" Width="100" DisplayMemberBinding="{Binding Author}"/>
                    <GridViewColumn Header="Date" Width="140" DisplayMemberBinding="{Binding Timestamp}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="80" Height="26" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="Compare" Width="100" Height="26"
                    Background="#28A745" Foreground="White" FontWeight="Bold"
                    IsEnabled="False" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
