<Window x:Class="RevitVersionControl.UI.PublishDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publish Snapshot" SizeToContent="Height" MinHeight="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Project Selection -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Label Content="Select Project:" FontWeight="Bold"/>
            <ComboBox Name="ProjectComboBox" Height="30" DisplayMemberPath="Name"/>
            <TextBlock Name="BaseFileStatusText" Margin="0,8,0,0" Foreground="#666666"
                       Text="Base file: unknown"/>
            <TextBlock Name="TrackedVersionStatusText" Margin="0,4,0,0" Foreground="#666666"
                       Text="Current synced version: unknown"/>
            <TextBlock Name="SaveRequirementNoteText" Margin="0,8,0,0" Foreground="#8A6D3B"
                       TextWrapping="Wrap"
                       Text="Unsaved standard edits can publish. New payload-backed additions require saving first."/>
        </StackPanel>

        <!-- Branch Info / Detached State -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Name="PublishingToBranchText" FontWeight="Bold" Foreground="#007ACC" 
                       Text="Publishing to active branch: main" FontSize="14" Margin="0,0,0,5"/>
            <StackPanel Name="DetachedBranchPanel" Visibility="Collapsed">
                <TextBlock Text="You are currently on an older commit and cannot publish here." 
                           Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,5">
                    To publish your changes, you must first do one of the following:
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="#333333" Margin="10,0,0,3">
                    • Pull the latest commit from the current branch (use History panel)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="#333333" Margin="10,0,0,3">
                    • Create a new branch from Manage Branches and switch to it
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Commit Message -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <Label Content="Commit Message:" FontWeight="Bold"/>
            <TextBox Name="CommitMessageTextBox" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>



        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="PublishButton" Content="Publish" Width="100" Height="35" 
                    Margin="0,0,10,0" Click="PublishButton_Click"
                    Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            <Button Name="CancelButton" Content="Cancel" Width="100" Height="35" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
