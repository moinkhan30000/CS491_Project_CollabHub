<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2026 = .NET 8 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <AssemblyName>RevitVersionControl</AssemblyName>
    <RootNamespace>RevitVersionControl</RootNamespace>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <AddInDestination>$(AppData)\Autodesk\Revit\Addins\2026</AddInDestination>
  </PropertyGroup>

  <!-- Revit API DLLs -->

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
		<HintPath>C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll</HintPath>
    </Reference>
    <Reference Include="RevitAPIUI">
		<HintPath>C:\Program Files\Autodesk\Revit 2026\RevitAPIUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copy addin + dll after build -->
  <Target Name="CopyAddInFiles" AfterTargets="Build">
    <Message Text="========================================" Importance="high" />
    <Message Text="ProjectDir: $(ProjectDir)" Importance="high" />
    <Message Text="TargetPath: $(TargetPath)" Importance="high" />
    <Message Text="TargetDir: $(TargetDir)" Importance="high" />
    <Message Text="AddInDestination: $(AddInDestination)" Importance="high" />
    <Message Text="========================================" Importance="high" />
    
    <!-- Copy .addin file -->
    <Exec Command="copy &quot;$(ProjectDir)RevitVersionControl.addin&quot; &quot;$(AddInDestination)\&quot;" />
    <Message Text="✓ .addin file copied" Importance="high" />
    
    <!-- Copy .dll file -->
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(AddInDestination)\&quot;" />
    <Message Text="✓ .dll file copied" Importance="high" />
    
    <!-- Copy .config file -->
    <Exec Command="copy &quot;$(TargetDir)*.config&quot; &quot;$(AddInDestination)\&quot;" />
    <Message Text="✓ .config files copied" Importance="high" />
  </Target>

</Project>

