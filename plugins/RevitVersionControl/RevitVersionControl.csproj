<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2026 = .NET 8 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <AssemblyName>RevitVersionControl</AssemblyName>
    <RootNamespace>RevitVersionControl</RootNamespace>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Revit API DLLs -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>D:\Install\Revit\Product\Autodesk\Revit 2026\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>D:\Install\Revit\Product\Autodesk\Revit 2026\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Copy addin + dll after build -->
  <PropertyGroup>
    <PostBuildEvent>
      copy "$(ProjectDir)*.addin" "%AppData%\Autodesk\Revit\Addins\2026\"
      copy "$(TargetPath)" "%AppData%\Autodesk\Revit\Addins\2026\"
      copy "$(TargetDir)*.config" "%AppData%\Autodesk\Revit\Addins\2026\"
    </PostBuildEvent>
  </PropertyGroup>

</Project>
